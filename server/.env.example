# Authentication: windows = Windows login of the account running the server (needs ODBC Driver 17/18), sql = DB_USER/DB_PASSWORD
DB_AUTH=sql
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
PORT=3000
CORS_ORIGIN=http://localhost:4200
# SQL Servers to search (comma-separated)
DB_SERVERS=MRA-SQL-UAT-01,hq-sql-sites-01
# Databases to show in the Database selector, in order; the FIRST one is the default.
# Name, or server/name when the same name exists on several servers. Empty = all databases with History tables.
DB_DATABASES=MrApple_DEV,MrApple,MrApple_UAT_MTM
TARGET_IDLE_MS=3600000
DB_USER=maui
DB_PASSWORD="<password>"
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=true
DB_REQUEST_TIMEOUT_MS=300000
TABLE_PATTERN=%HistoryT
ACTIVITY_POLL_MS=15000
LAST_CHANGE_SCAN_MAX_ROWS=1000000
LAST_CHANGE_REFRESH_MS=900000
LARGE_TABLE_ROWS=1000000
READ_UNCOMMITTED=true
DEFAULT_SITE_ID=1
# Optional: separate login for SQL Agent job history (needs SELECT on msdb.dbo.sysjobs/sysjobhistory/sysjobsteps)
MSDB_USER=
MSDB_PASSWORD=
# Activity history (SQL activity page > History / Audit history tabs). Saved to a local SQLite file, never to SQL Server.
# Servers to record, comma-separated (each must be in DB_SERVERS). Empty = off. Runs all the time, viewer or not.
HISTORY_SERVERS=MRA-SQL-UAT-01
HISTORY_SAMPLE_MS=5000
HISTORY_AUDIT_POLL_MS=30000
HISTORY_RETENTION_DAYS=30
HISTORY_DB_PATH=data/history.db
# SQL Server Audit a DBA created for SQL Monitor (the Audit history tab shows the setup script)
HISTORY_AUDIT_NAME=SQL_Monitor_Audit
# Optional: audit file pattern when it cannot be looked up, e.g. D:\SQLAudit\SQL_Monitor_Audit_*.sqlaudit
HISTORY_AUDIT_FILE_PATTERN=
